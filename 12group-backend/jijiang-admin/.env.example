# Local admin development example.
# Leave VITE_API_BASE empty so requests go through the Vite proxy.
# The proxy target is the locally running backend.
VITE_API_BASE=
VITE_ADMIN_PROXY_TARGET=http://localhost:8080

# Optional Docker Compose settings when running from 12group-backend/docker-compose.yml.
ADMIN_PORT=8088
ADMIN_CONTAINER_NAME=jijiang-admin
