# Root Docker Compose example. For independent local runs, use each service's
# own .env.example in 12group-backend/, jijiang-payment-server/,
# 12group-frontend/, and 12group-backend/jijiang-admin/.
MYSQL_ROOT_PASSWORD=change-me-root
DB_USERNAME=jijiang
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me-redis
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_DISPLAY_NAME=JiJiang Admin
PAYMENT_SERVER_BASE_URL=https://0721ciallo.com
PAYMENT_SERVER_CLIENT_ID=jijiang-app
PAYMENT_SERVER_SHARED_SECRET=change-me-payment-internal-secret
PAYMENT_SERVER_PORT=6670
XUNHU_APP_ID=
XUNHU_APP_SECRET=
XUNHU_GATEWAY=https://api.xunhupay.com/payment/do.html
XUNHU_NOTIFY_URL=https://0721ciallo.com/api/payment/xunhu-notify
XUNHU_RETURN_URL=https://0721ciallo.com/payment/return
XUNHU_CALLBACK_URL=https://0721ciallo.com/payment/callback
APP_SERVER_CALLBACK_ENABLED=false
APP_SERVER_CALLBACK_URL=
