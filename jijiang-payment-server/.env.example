# Local payment-server runtime config. Copy to .env inside this directory.
SPRING_PROFILES_ACTIVE=dev
PAYMENT_SERVER_PORT=6670

# XunhuPay config. Fill these for real payment integration.
XUNHU_APP_ID=
XUNHU_APP_SECRET=
XUNHU_GATEWAY=https://api.xunhupay.com/payment/do.html
XUNHU_NOTIFY_URL=
XUNHU_RETURN_URL=
XUNHU_CALLBACK_URL=

# Optional callback to the app backend.
APP_SERVER_CALLBACK_ENABLED=false
APP_SERVER_CALLBACK_URL=http://localhost:8080/internal/payment/callback
APP_SERVER_CLIENT_ID=jijiang-app
APP_SERVER_SHARED_SECRET=dev-payment-secret-change-me

# Optional Redis settings used by dev/shared-db/prod profiles.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional MySQL settings for shared-db/prod profiles.
PAYMENT_DB_URL=jdbc:mysql://127.0.0.1:3306/jijiang?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
PAYMENT_DB_USERNAME=jijiang
PAYMENT_DB_PASSWORD=jijiang
PAYMENT_DB_POOL_MAX_SIZE=5
PAYMENT_DB_POOL_MIN_IDLE=1
FLYWAY_ENABLED=true
